{
  "name": "iqra-sbms",
  "version": "2.0.0",
  "author": "nobrelli <ryuedwards@gmail.com>",
  "license": "MIT",
  "private": true,
  "main": "api/client_server.js",
  "scripts": {
    "setup": "py setup.local.py",
    "install:client": "cd client && yarn install",
    "install:server": "cd server && poetry install --no-root",
    "install:all": "concurrently \"yarn install:client\" \"yarn install:server\"",
    "build": "tsc api/client_server.local.ts",
    "run:client": "yarn build && node api/client_server.local.js",
    "run:server": "cd server && poetry shell && poetry poe run-dev",
    "run:all": "concurrently \"yarn run:client\" \"yarn run:server\""
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "@fastify/static": "^8.0.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.8.6",
    "concurrently": "^9.0.1"
  }
}