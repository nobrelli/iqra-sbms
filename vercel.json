{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "rewrites": [
        { "source": "/api/v2(.*)", "destination": "/api/api_server" },
        { "source": "/(.*)", "destination": "/api/client_server" }
    ],
    "functions": {
        "api/api_server.py": {
            "maxDuration": 60,
            "memory": 1024
        }
    },
    "outputDirectory": ".",
    "regions": ["hkg1"]
}